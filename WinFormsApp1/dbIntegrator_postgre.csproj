<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    
    <StartupObject>AgentApp.Program</StartupObject>
    
    <PackageIcon>dbIntegrator.png</PackageIcon>
    
    <AssemblyVersion>1.0.20.2</AssemblyVersion>
    
    <AssemblyName>PromptPrivacy_PostgreDBIntegratorWindows</AssemblyName>
    
    <ApplicationIcon>Resources\logop256.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin\**" />
    <EmbeddedResource Remove="bin\**" />
    <None Remove="bin\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="DatabaseConfig.cs" />
    <Compile Remove="Form1OLD.cs" />
    <Compile Remove="Form1OLD.Designer.cs" />
    <Compile Remove="Form21.cs" />
    <Compile Remove="Form21.Designer.cs" />
    <Compile Remove="Logger.cs" />
    <Compile Remove="PostgresHelper_old.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Remove="Form1OLD.resx" />
    <EmbeddedResource Remove="Form21.resx" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\logop256.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="9.0.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <PackageReference Include="System.Data.Odbc" Version="8.0.0" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="MetroSet UI">
      <HintPath>..\..\..\..\..\GitHub\eSpark-Consultants\src\aaronshaver-windowsagent\eSpark_WindowsFIA\bin\MetroSet UI.dll</HintPath>
    </Reference>
    <Reference Include="NLog">
      <HintPath>bin\Debug\net6.0-windows8.0\NLog.dll</HintPath>
    </Reference>
    <Reference Include="System.Data.SQLite">
      <HintPath>obj\Debug\System.Data.SQLite.dll</HintPath>
    </Reference>
    <Reference Include="System.Data.SQLite.EF6">
      <HintPath>obj\Debug\System.Data.SQLite.EF6.dll</HintPath>
    </Reference>
    <Reference Include="System.Data.SQLite.Linq">
      <HintPath>obj\Debug\System.Data.SQLite.Linq.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\dbIntegrator.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="bin\Debug\net6.0-windows\Resources\" />
  </ItemGroup>

</Project>